# Django
DJANGO_SECRET_KEY=your-very-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# PostgreSQL — compte administrateur unique : héberge 'default' (POSTGRES_DB)
# et crée/administre toutes les bases par institut (voir DB_RYTAL_* plus bas).
POSTGRES_DB=academic_db
POSTGRES_USER=academic_user
POSTGRES_PASSWORD=strongpassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Base de maintenance utilisée pour émettre CREATE DATABASE / ALTER DATABASE (existe
# toujours sur un serveur PostgreSQL, ne pas remplacer par POSTGRES_DB ici).
POSTGRES_MAINTENANCE_DB=postgres

# ── Bases PostgreSQL par institut ──────────────────────────────────────────────
# Un bloc "DB_RYTAL_<CODE>_NAME/HOST/PORT/USER/PASSWORD" est ajouté automatiquement
# ici à la création de chaque institut (voir
# academic_core/apps/academic_structure/signals.py::auto_create_institute_db et
# academic_core/tenant_databases.py::append_tenant_env_block). Ne pas éditer ces
# blocs à la main sauf pour faire pointer un institut vers un host/compte différent
# du compte admin par défaut — dans ce cas, ajuster HOST/PORT/USER/PASSWORD pour ce
# seul institut, NAME doit rester "db_rytal_<code>".
# Exemple généré automatiquement pour un institut de code ISI :
# DB_RYTAL_ISI_NAME=db_rytal_isi
# DB_RYTAL_ISI_HOST=db
# DB_RYTAL_ISI_PORT=5432
# DB_RYTAL_ISI_USER=academic_user
# DB_RYTAL_ISI_PASSWORD=strongpassword123

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@university.edu

# En développement uniquement (config/settings/development.py) : par défaut
# les emails s'impriment dans la console au lieu d'être réellement envoyés.
# Mettre à True pour forcer un envoi réel via le backend/identifiants SMTP
# ci-dessus (utile par ex. pour tester le lien « code d'activation oublié »).
DEV_FORCE_REAL_EMAIL=False

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Chatbot RYTAL (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Verrou d'activation de la plateforme (voir academic_core/apps/accounts/platform_activation.py)
# — obligatoire pour démarrer le serveur en production, jamais stocké dans le dépôt.
PLATFORM_MASTER_KEY=change-me-to-a-long-random-value

# Les deux SEULES adresses autorisées à recevoir le lien de réinitialisation
# du code d'activation en cas d'oubli — jamais visibles dans le code source
# ni dans l'interface web, à définir uniquement ici (fichier .env local au
# serveur, jamais commité dans le dépôt).
PLATFORM_RESET_EMAIL_1=your-first-recovery@email.com
PLATFORM_RESET_EMAIL_2=your-second-recovery@email.com
