# Secrets — jamais dans le dépôt
.env
.env.*
!.env.example

# Bases de données locales (données réelles d'étudiants/finances par institut)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
db.sqlite3
db_inst_*.sqlite3

# Bases d'instituts supprimés, archivées au lieu d'être effacées (voir
# academic_structure/utils.py::archive_institut_db)
archives/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Django
media/
staticfiles/
*.log

# Dumps PostgreSQL par institut (données réelles étudiants/finances) — jamais
# dans le dépôt ; à transférer sur le serveur par canal sécurisé (voir DEPLOYMENT.md)
bd/

# Certificats TLS (clés privées) — générés/déployés sur le serveur uniquement
ssl/
nginx/ssl/

# Sorties de run capturées
server_err.txt
server_out.txt

# Worktrees et artefacts d'outils
.claude/worktrees/

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
sauvegarde/
