generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SCOLARITE
  TEACHER
  STUDENT
}

enum EvaluationType {
  CC
  TP
  EXAM
  RATTRAPAGE
  DEVOIR
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PENDING
  SIGNED
  APPROVED
  REJECTED
}

enum AbsenceStatus {
  UNJUSTIFIED
  PENDING
  JUSTIFIED
}

enum NotificationType {
  CANCELLATION
  GRADE
  ABSENCE
  GENERAL
  RESCHEDULED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role
  phone     String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher       Teacher?
  student       Student?
  notifications Notification[]

  @@map("users")
}

model Teacher {
  id          String  @id @default(uuid())
  userId      String  @unique
  employeeId  String  @unique
  department  String?
  speciality  String?
  hourlyRate  Float?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetableSlots   TimetableSlot[]
  attendanceSheets AttendanceSheet[]
  cancellations    CourseCancellation[]

  @@map("teachers")
}

model Student {
  id           String  @id @default(uuid())
  userId       String  @unique
  studentId    String  @unique
  classId      String?
  enrolledYear Int

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  class           Class?           @relation(fields: [classId], references: [id])
  grades          Grade[]
  absences        StudentAbsence[]

  @@map("students")
}

model Class {
  id          String  @id @default(uuid())
  name        String  @unique
  level       String
  specialty   String?
  capacity    Int     @default(30)
  academicYear String

  students       Student[]
  timetableSlots TimetableSlot[]

  @@map("classes")
}

model Subject {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  coefficient  Float   @default(1)
  hoursPerWeek Float?
  description  String?

  timetableSlots TimetableSlot[]
  evaluations    Evaluation[]

  @@map("subjects")
}

model Room {
  id       String  @id @default(uuid())
  name     String  @unique
  building String?
  capacity Int
  type     String?

  timetableSlots TimetableSlot[]

  @@map("rooms")
}

model TimetableSlot {
  id        String   @id @default(uuid())
  classId   String
  teacherId String
  subjectId String
  roomId    String
  dayOfWeek Int      // 0=Mon, 1=Tue, ...
  startTime String   // "08:00"
  endTime   String   // "10:00"
  semester  Int      // 1 or 2
  weekType  String?  // "A", "B", or null for every week
  createdAt DateTime @default(now())

  class            Class            @relation(fields: [classId], references: [id])
  teacher          Teacher          @relation(fields: [teacherId], references: [id])
  subject          Subject          @relation(fields: [subjectId], references: [id])
  room             Room             @relation(fields: [roomId], references: [id])
  attendanceSheets AttendanceSheet[]
  cancellations    CourseCancellation[]
  absences         StudentAbsence[]

  @@map("timetable_slots")
}

model AttendanceSheet {
  id              String           @id @default(uuid())
  timetableSlotId String
  teacherId       String
  sessionDate     DateTime
  status          AttendanceStatus @default(PENDING)
  signedAt        DateTime?
  validatedAt     DateTime?
  validatedBy     String?
  remarks         String?

  timetableSlot TimetableSlot @relation(fields: [timetableSlotId], references: [id])
  teacher       Teacher       @relation(fields: [teacherId], references: [id])

  @@map("attendance_sheets")
}

model Evaluation {
  id        String         @id @default(uuid())
  subjectId String
  classId   String
  type      EvaluationType
  name      String
  date      DateTime
  maxScore  Float          @default(20)
  weight    Float          @default(1)
  semester  Int
  createdAt DateTime       @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
  grades  Grade[]

  @@map("evaluations")
}

model Grade {
  id           String   @id @default(uuid())
  studentId    String
  evaluationId String
  score        Float?
  isAbsent     Boolean  @default(false)
  comment      String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student    @relation(fields: [studentId], references: [id])
  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@unique([studentId, evaluationId])
  @@map("grades")
}

model StudentAbsence {
  id              String        @id @default(uuid())
  studentId       String
  timetableSlotId String
  sessionDate     DateTime
  status          AbsenceStatus @default(UNJUSTIFIED)
  justification   String?
  documentPath    String?
  reportedBy      String?
  createdAt       DateTime      @default(now())

  student       Student       @relation(fields: [studentId], references: [id])
  timetableSlot TimetableSlot @relation(fields: [timetableSlotId], references: [id])

  @@map("student_absences")
}

model CourseCancellation {
  id              String             @id @default(uuid())
  timetableSlotId String
  teacherId       String
  sessionDate     DateTime
  reason          String
  status          CancellationStatus @default(PENDING)
  rescheduledDate DateTime?
  rescheduledRoom String?
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime           @default(now())

  timetableSlot TimetableSlot @relation(fields: [timetableSlotId], references: [id])
  teacher       Teacher       @relation(fields: [teacherId], references: [id])
  notifications Notification[]

  @@map("course_cancellations")
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  isRead       Boolean          @default(false)
  cancellationId String?
  createdAt    DateTime         @default(now())

  user         User                @relation(fields: [userId], references: [id])
  cancellation CourseCancellation? @relation(fields: [cancellationId], references: [id])

  @@map("notifications")
}
